    <!-- jQuery, Bootstrap JS, Select2 JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <!-- SweetAlert2 para mensajes bonitos -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            // Inicializar Select2 con mejores opciones
            $('.select2-enhanced').each(function() {
                $(this).select2({
                    theme: 'bootstrap-5',
                    placeholder: $(this).find('option[value=""]').text() || 'Seleccionar',
                    allowClear: true,
                    width: '100%',
                    dropdownAutoWidth: true,
                    language: {
                        noResults: function() {
                            return "No se encontraron resultados";
                        }
                    }
                });
            });

            // Animación para los campos
            $('.animate-field').each(function(index) {
                $(this).css('animation-delay', (index * 0.1) + 's');
            });

            // Validación en tiempo real y cálculo de progreso
            $('input, select').on('input change', function() {
                validateField(this);
                updateProgressBar();
            });

            // Forzar redibujado si hay problemas visuales
            $(window).on('resize', function() {
                $('.select2-enhanced').select2('close');
            });
        });

        // Función para calcular la edad
        function calculateAge() {
            const fechaNacimiento = new Date($('#FechaNacimientoInscripciones').val());
            if (isNaN(fechaNacimiento.getTime())) return;

            const hoy = new Date();
            let edad = hoy.getFullYear() - fechaNacimiento.getFullYear();
            const mes = hoy.getMonth() - fechaNacimiento.getMonth();

            if (mes < 0 || (mes === 0 && hoy.getDate() < fechaNacimiento.getDate())) {
                edad--;
            }

            $('#EdadInscripciones').val(edad);

            // Actualizar grupo etareo automáticamente
            updateGrupoEtareo(edad);
        }

        // Función para actualizar grupo etareo basado en la edad
        function updateGrupoEtareo(edad) {
            let grupo = '';

            if (edad >= 0 && edad <= 5) grupo = 'INFANCIA (0 - 5 AÑOS)';
            else if (edad >= 6 && edad <= 11) grupo = 'NIÑEZ (6 - 11 AÑOS)';
            else if (edad >= 12 && edad <= 19) grupo = 'ADOLESCENTES (12 - 19 AÑOS)';
            else if (edad >= 20 && edad <= 25) grupo = 'JUVENTUD (20 - 25 AÑOS)';
            else if (edad >= 26 && edad <= 60) grupo = 'ADULTEZ (26 - 60 AÑOS)';
            else if (edad > 60) grupo = 'ADULTO MAYOR (+ 60 AÑOS)';

            if (grupo) {
                $('#GrupoEtarreoInscripciones').val(grupo).trigger('change');
            }
        }

        // Función para validar campos en tiempo real
        function validateField(field) {
            const $field = $(field);
            const value = $field.val();
            let isValid = true;

            if ($field.prop('required') && !value) {
                isValid = false;
            } else if ($field.attr('type') === 'email' && value) {
                @*const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;*@
                isValid = emailRegex.test(value);
            } else if ($field.attr('type') === 'number' && value) {
                isValid = !isNaN(value);
            }

            if (isValid) {
                $field.removeClass('is-invalid');
            } else {
                $field.addClass('is-invalid');
            }

            return isValid;
        }

        // Función para validar email
        function validateEmail(input) {
            const email = input.value;
            @*const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;*@

            if (email && !emailRegex.test(email)) {
                $(input).addClass('is-invalid');
                return false;
            } else {
                $(input).removeClass('is-invalid');
                return true;
            }
        }

        // Función para validar tipo de archivo
        function validateFileType(inputId) {
            const input = document.getElementById(inputId);
            const file = input.files[0];
            const $input = $(input);

            if (file) {
                const fileType = file.type;
                if (fileType !== 'application/pdf') {
                    $input.addClass('is-invalid');
                    Swal.fire({
                        icon: 'error',
                        title: 'Tipo de archivo incorrecto',
                        text: 'Por favor, sube un archivo PDF.',
                    });
                    input.value = '';
                    return false;
                } else {
                    $input.removeClass('is-invalid');
                    return true;
                }
            }
            return false;
        }

        // Función para mostrar/ocultar campos según programa seleccionado
        function toggleInputFields() {
            const selectedValue = $('#ProgramaInscripciones').val();
            const requiredOption = "PROGRAMA JORNADA DEPORTIVAS ESCOLARES COMPLEMENTARIAS Y/O ESCUELAS DE FORMACIÓN";
            const fields = ['DocumentoPdfField', 'SaludPdfField', 'AutorizacionPdfField', 'CedulaPadrePdfField'];

            fields.forEach(function(fieldId) {
                const $field = $('#' + fieldId);
                if (selectedValue === requiredOption) {
                    $field.removeClass('hidden').addClass('animate__animated animate__fadeIn');
                } else {
                    $field.addClass('hidden');
                    $('#' + fieldId.replace('Field', '')).val('');
                }
            });

            updateProgressBar();
        }

        // Función para actualizar la barra de progreso
        function updateProgressBar() {
            const totalFields = $('input[required], select[required]').length;
            let filledFields = 0;

            $('input[required], select[required]').each(function() {
                if ($(this).val()) {
                    filledFields++;
                }
            });

            const percentage = Math.round((filledFields / totalFields) * 100);
            $('#form-progress').css('width', percentage + '%');
            $('#progress-percentage').text(percentage + '%');
        }

        // Función para manejar el envío del formulario
        $('#FormFisioterapia').on('submit', function(e) {
            e.preventDefault();

            // Validar todos los campos requeridos
            let isValid = true;
            $('input[required], select[required]').each(function() {
                if (!validateField(this)) {
                    isValid = false;
                }
            });

            if (isValid) {
                Swal.fire({
                    title: '¿Estás seguro?',
                    text: "¿Deseas guardar la información del deportista?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sí, guardar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Aquí iría la lógica para enviar el formulario
                        Swal.fire(
                            '¡Guardado!',
                            'La información del deportista ha sido guardada.',
                            'success'
                        );

                        // Simular envío del formulario
                        setTimeout(() => {
                            // Createobj(); // Función original para guardar
                        }, 1500);
                    }
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Campos incompletos',
                    text: 'Por favor completa todos los campos requeridos.',
                });

                // Desplazarse al primer campo con error
                $('html, body').animate({
                    scrollTop: $('.is-invalid').first().offset().top - 100
                }, 500);
            }
        });

        // Función para manejar cambios en selects (original)
        function handleSelectionChange() {
            // Implementación original si es necesaria
        }

        // Convertir a mayúsculas los campos de texto
        document.addEventListener('DOMContentLoaded', function() {
            const inputFields = [
                'PrimerNombreInscripciones', 'SegundonombreInscripciones',
                'PrimerApellidoInscripciones', 'SegundoApellidoInscripciones',
                'PaisNacimientoInscripciones', 'DepartamentoInscripciones',
                'MunicipioInscripciones', 'Eps', 'NombreEntrenador',
                'NombreContacto', 'DireccionResidencia', 'BarrioResidencia',
                'MunicipioResidencia'
            ];

            inputFields.forEach(function(fieldId) {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.addEventListener('input', function(event) {
                        this.value = this.value.toUpperCase();
                    });
                }
            });
        });
        // Modifica la inicialización de Select2 para el programa
        $('#ProgramaInscripciones').select2({
            theme: 'bootstrap-5',
            placeholder: 'Seleccionar programa',
            allowClear: true,
            width: '100%',
            dropdownAutoWidth: true,
            templateResult: function (option) {
                if (!option.id) return option.text;

                // Mostrar texto completo en el dropdown
                var fullText = $(option.element).data('fulltext') || option.text;
                return $('<span>').text(fullText);
            },
            templateSelection: function (option) {
                if (!option.id) return option.text;

                // Mostrar texto completo cuando está seleccionado
                var fullText = $(option.element).data('fulltext') || option.text;
                return $('<span>').text(fullText);
            }
        });
    </script>
