<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Formulario de Inscripción Deportiva</title>
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    :root {
        --primary-color: #2c3e50;
        --secondary-color: #3498db;
        --accent-color: #e74c3c;
        --light-gray: #f8f9fa;
        --dark-gray: #343a40;
    }

    body {
        background-color: #f5f7fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--dark-gray);
    }

    .form-container {
        background: white;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        padding: 30px;
        margin-top: 30px;
        margin-bottom: 30px;
    }

    .hidden {
        display: none !important;
    }

    .section-title {
        color: var(--primary-color);
        margin-top: 25px;
        margin-bottom: 20px;
        padding-bottom: 8px;
        border-bottom: 2px solid var(--secondary-color);
        font-weight: 600;
        font-size: 1.25rem;
    }

        .section-title i {
            color: var(--secondary-color);
        }

    .form-label {
        font-weight: 500;
        margin-bottom: 8px;
        color: var(--primary-color);
    }

    .form-control, .form-select {
        border-radius: 6px;
        padding: 10px 15px;
        border: 1px solid #ced4da;
        transition: all 0.3s;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 0.25rem rgba(52, 152, 219, 0.25);
        }

    .input-with-icon {
        position: relative;
    }

        .input-with-icon i {
            position: absolute;
            left: 15px;
            top: 12px;
            color: var(--secondary-color);
        }

        .input-with-icon input, .input-with-icon select {
            padding-left: 40px;
        }

    .btn-submit {
        background-color: var(--secondary-color);
        color: white;
        margin-top: 25px;
        padding: 12px 25px;
        border: none;
        border-radius: 6px;
        font-weight: 500;
        letter-spacing: 0.5px;
        transition: all 0.3s;
        width: 100%;
    }

        .btn-submit:hover {
            background-color: #2980b9;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .btn-submit i {
            margin-right: 8px;
        }

    .animate-field {
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .form-note {
        background-color: var(--light-gray);
        border-left: 4px solid var(--secondary-color);
        padding: 15px;
        margin: 25px 0;
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .file-upload-container {
        border: 2px dashed #ced4da;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        transition: all 0.3s;
        background-color: var(--light-gray);
    }

        .file-upload-container:hover {
            border-color: var(--secondary-color);
            background-color: rgba(52, 152, 219, 0.05);
        }

    .file-upload-label {
        display: block;
        margin-bottom: 10px;
        font-weight: 500;
        color: var(--primary-color);
    }

    .file-upload-icon {
        font-size: 2rem;
        color: var(--secondary-color);
        margin-bottom: 10px;
    }

    .required-field::after {
        content: " *";
        color: var(--accent-color);
    }

    .invalid-feedback {
        color: var(--accent-color);
        font-size: 0.85rem;
        margin-top: 5px;
    }

    /* Correcciones para Select2 con Bootstrap 5 */
    .select2-container--bootstrap-5 {
        margin-bottom: 0;
    }

        .select2-container--bootstrap-5 .select2-selection {
            min-height: calc(1.5em + 1rem + 2px);
            padding: 0.5rem 1rem;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
            padding-left: 0;
            line-height: 1.5;
        }

        .select2-container--bootstrap-5 .select2-dropdown {
            margin-top: 0.5rem;
            border-radius: 0.375rem;
            border: 1px solid #ced4da;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field {
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

    /* Ajustar márgenes específicos para los selects */
    .select2-enhanced {
        margin-bottom: 0 !important;
    }

    /* Mantener el margen inferior para otros campos */
    .animate-field:not(.select-field) {
        margin-bottom: 20px;
    }

    /* Ajuste para campos con iconos y Select2 */
    .input-with-icon .select2-container--bootstrap-5 .select2-selection {
        padding-left: 40px;
    }

    /* Asegurar que el dropdown no se corte */
    .select2-container--open {
        z-index: 1060 !important;
    }
</style>
