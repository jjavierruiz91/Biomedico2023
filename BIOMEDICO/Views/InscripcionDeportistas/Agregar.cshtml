<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulario de Inscripción Deportiva</title>
    Bootstrap CSS
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    Font Awesome para íconos
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    Select2 para selects mejorados
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    Animate.css para animaciones
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <style>
        :root {
            --primary-color: #3498db;
            --secondary-color: #2ecc71;
            --accent-color: #e74c3c;
            --light-gray: #f8f9fa;
            --dark-gray: #343a40;
            --text-color: #2c3e50;
            --border-radius: 8px;
            --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s ease;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text-color);
            background-color: #f5f7fa;
            line-height: 1.6;
        }
        /* Estilos para el select del programa */
        .select2-container--bootstrap-5 .select2-selection--single {
            white-space: normal !important;
            height: auto !important;
            min-height: 38px;
            padding: 8px 12px !important;
        }

            .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
                white-space: normal !important;
                word-wrap: break-word !important;
            }

        .select2-results__option {
            white-space: normal !important;
            word-wrap: break-word !important;
            padding: 8px 12px !important;
        }
        .form-container {
            background-color: white;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            padding: 2rem;
            margin: 2rem auto;
            max-width: 1200px;
        }

        .form-header {
            text-align: center;
            margin-bottom: 2rem;
            border-bottom: 2px solid var(--light-gray);
            padding-bottom: 1rem;
        }

        .form-header h2 {
            color: var(--primary-color);
            font-weight: 700;
        }

        .form-header p {
            color: var(--dark-gray);
        }
        .programa-nombre {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 300px; /* Ajusta según necesidad */
        }
        .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--text-color);
        }

        .form-control {
            border: 1px solid #ced4da;
            border-radius: var(--border-radius);
            padding: 0.5rem 0.75rem;
            height: auto;
            transition: var(--transition);
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(52, 152, 219, 0.25);
        }

        .form-control:hover {
            border-color: var(--primary-color);
        }

        /* Estilos específicos para Select2 */
        .select2-container .select2-selection--single {
            height: auto !important;
            padding: 0.5rem 0.75rem !important;
            border: 1px solid #ced4da !important;
            border-radius: var(--border-radius) !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 100% !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.5 !important;
            padding-left: 0 !important;
        }

        .select2-dropdown {
            border: 1px solid #ced4da !important;
            border-radius: var(--border-radius) !important;
        }

        .input-with-icon {
            position: relative;
        }

        .input-with-icon i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--primary-color);
            z-index: 2;
        }

        .input-with-icon .form-control {
            padding-left: 40px;
        }

        .input-with-icon .select2-selection--single {
            padding-left: 40px !important;
        }

        .progress-container {
            margin-bottom: 2rem;
        }

        .progress {
            height: 10px;
            border-radius: 5px;
            background-color: #e9ecef;
        }

        .progress-bar {
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            transition: width 0.6s ease;
        }

        .btn-submit {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            color: white;
            font-weight: 600;
            padding: 0.75rem 2rem;
            border-radius: 50px;
            transition: var(--transition);
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
            display: block;
            margin: 2rem auto 0;
            width: 200px;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4);
            color: white;
        }

        .section-title {
            color: var(--primary-color);
            font-weight: 600;
            margin: 1.5rem 0 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--light-gray);
            grid-column: 1 / -1;
        }

        .form-note {
            background-color: #f8f9fa;
            border-left: 4px solid var(--primary-color);
            padding: 1rem;
            border-radius: 0 var(--border-radius) var(--border-radius) 0;
            margin: 1.5rem 0;
            grid-column: 1 / -1;
        }

        .hidden {
            display: none;
        }

        .animate-field {
            animation: fadeInUp 0.5s ease forwards;
        }

        .invalid-feedback {
            color: var(--accent-color);
            font-size: 0.85rem;
        }

        .is-invalid {
            border-color: var(--accent-color) !important;
        }

        .is-invalid:focus {
            box-shadow: 0 0 0 0.25rem rgba(231, 76, 60, 0.25) !important;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }

        @*@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }*@

        @*@media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-container {
                padding: 1rem;
            }

            .form-header h2 {
                font-size: 1.5rem;
            }

            .section-title, .form-note {
                grid-column: 1;
            }
        }*@
    </style>


</head>
<body>
    <div class="container form-container animate__animated animate__fadeIn">
        <!-- Barra de progreso -->
        <div class="progress-container">
            <div class="d-flex justify-content-between mb-2">
                <span>Progreso del formulario</span>
                <span id="progress-percentage">0%</span>
            </div>
            <div class="progress">
                <div class="progress-bar" id="form-progress" role="progressbar" style="width: 0%"></div>
            </div>
        </div>

        <!-- Encabezado del formulario -->
        <div class="form-header">
            <h2><i class="fas fa-running me-2"></i>Formulario de Inscripción Deportiva</h2>
            <p class="mb-0">Complete todos los campos para registrar al deportista</p>
        </div>

        <form id="FormFisioterapia" name="FormFisioterapia" class="form-grid">
            <!-- Sección 1: Información del programa -->
            <h5 class="section-title"><i class="fas fa-tasks me-2"></i>Información del Programa</h5>

            <!-- Reemplaza tu div del programa con este código -->
            <div class="animate-field">
                <label for="ProgramaInscripciones" class="form-label">Programa en el que desea inscribirse <span class="text-danger">*</span></label>
                <select class="form-select select2-enhanced" id="ProgramaInscripciones" name="ProgramaInscripciones" required onchange="toggleInputFields()">
                    <option value="">Seleccionar programa</option>
                    <option value="PROGRAMA DEPORTE SOCIAL COMUNITARIO">PROGRAMA DEPORTE SOCIAL COMUNITARIO</option>
                    <option value="PROGRAMA DEPORTISTAS ALTO RENDIMIENTO - SELECCIONES DEPARTAMENTALES"
                            data-fulltext="PROGRAMA DEPORTISTAS ALTO RENDIMIENTO - SELECCIONES DEPARTAMENTALES">
                        PROGRAMA DEPORTISTAS ALTO RENDIMIENTO - SELECC. DEPART.
                    </option>
                    <option value="PROGRAMA HÁBITOS Y ESTILOS DE VIDA SALUDABLES">PROGRAMA HÁBITOS Y ESTILOS DE VIDA SALUDABLES</option>
                    <option value="PROGRAMA JORNADA DEPORTIVAS ESCOLARES COMPLEMENTARIAS Y/O ESCUELAS DE FORMACIÓN"
                            data-fulltext="PROGRAMA JORNADA DEPORTIVAS ESCOLARES COMPLEMENTARIAS Y/O ESCUELAS DE FORMACIÓN">
                        PROGRAMA JORNADA DEPORTIVAS ESCOLARES COMPLEMENTARIAS Y/O ESCUELAS DE FORMACIÓN.
                    </option>
                    <option value="PROGRAMA JUEGOS INTERCOLEGIADOS">PROGRAMA JUEGOS INTERCOLEGIADOS</option>
                    <option value="PROGRAMA RECREACIÓN">PROGRAMA RECREACIÓN</option>
                    <option value="PROGRAMA VACACIONAL">PROGRAMA VACACIONAL</option>
                </select>
            </div>

            <div class="animate-field hidden" id="DocumentoPdfField">
                <label for="DocumentoPdf" class="form-label">Cargar Documento Identidad Deportista</label>
                <div class="input-with-icon">
                    <i class="fas fa-file-pdf"></i>
                    <input type="file" class="form-control" id="DocumentoPdf" name="DocumentoPdf" accept="application/pdf" onchange="validateFileType('DocumentoPdf')" />
                </div>
                <div class="invalid-feedback">Por favor, sube un archivo PDF válido.</div>
            </div>

            <div class="animate-field hidden" id="SaludPdfField">
                <label for="SaludPdf" class="form-label">Cargar Documento Afiliación salud</label>
                <div class="input-with-icon">
                    <i class="fas fa-file-pdf"></i>
                    <input type="file" class="form-control" id="SaludPdf" name="SaludPdf" accept="application/pdf" onchange="validateFileType('SaludPdf')" />
                </div>
                <div class="invalid-feedback">Por favor, sube un archivo PDF válido.</div>
            </div>

            <div class="animate-field hidden" id="AutorizacionPdfField">
                <label for="AutorizacionPdf" class="form-label">Cargar Documento Autorización del padre</label>
                <div class="input-with-icon">
                    <i class="fas fa-file-pdf"></i>
                    <input type="file" class="form-control" id="AutorizacionPdf" name="AutorizacionPdf" accept="application/pdf" onchange="validateFileType('AutorizacionPdf')" />
                </div>
                <div class="invalid-feedback">Por favor, sube un archivo PDF válido.</div>
            </div>

            <div class="animate-field hidden" id="CedulaPadrePdfField">
                <label for="CedulaPadrePdf" class="form-label">Cargar Documento Responsable del Deportista</label>
                <div class="input-with-icon">
                    <i class="fas fa-file-pdf"></i>
                    <input type="file" class="form-control" id="CedulaPadrePdf" name="CedulaPadrePdf" accept="application/pdf" onchange="validateFileType('CedulaPadrePdf')" />
                </div>
                <div class="invalid-feedback">Por favor, sube un archivo PDF válido.</div>
            </div>

            <!-- Sección 2: Información personal -->
            <h5 class="section-title"><i class="fas fa-user me-2"></i>Información Personal</h5>

            <div class="animate-field">
                <label for="TipoIdentificacionInscripciones" class="form-label">Tipo Identificación <span class="text-danger">*</span></label>
                <select class="form-select select2-enhanced" id="TipoIdentificacionInscripciones" name="TipoIdentificacionInscripciones">
                    <option value="">Seleccionar tipo</option>
                    <option value="CEDULA DE CIUDADANIA">CEDULA DE CIUDADANIA</option>
                    <option value="TARJETA DE IDENTIDAD">TARJETA DE IDENTIDAD</option>
                    <option value="CEDULA DE EXTRANJERIA">CEDULA DE EXTRANJERIA</option>
                    <option value="PASAPORTE">PASAPORTE</option>
                    <option value="REGISTRO CIVIL">REGISTRO CIVIL</option>
                    <option value="OTRO">OTRO</option>
                </select>
            </div>

            <div class="animate-field">
                <label for="NumIdentificacionInscripciones" class="form-label">Número Identificación <span class="text-danger">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-id-card"></i>
                    <input class="form-control" id="NumIdentificacionInscripciones" name="NumIdentificacionInscripciones" type="number" required />
                </div>
                <div class="invalid-feedback">Por favor, ingresa un número de identificación válido.</div>
            </div>

            <div class="animate-field">
                <label for="JornadaDeportiva" class="form-label">Jornada Deportiva <span class="text-danger">*</span></label>
                <select class="form-select select2-enhanced" id="JornadaDeportiva" name="JornadaDeportiva" required>
                    <option value="">Seleccionar jornada</option>
                    <option value="JORNADA DE LA MAÑANA - AM">JORNADA DE LA MAÑANA - AM</option>
                    <option value="JORNADA DE LA TARDE - PM">JORNADA DE LA TARDE - PM</option>
                </select>
            </div>

            <div class="animate-field">
                <label for="PrimerNombreInscripciones" class="form-label">Primer Nombre <span class="text-danger">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-user"></i>
                    <input class="form-control" id="PrimerNombreInscripciones" name="PrimerNombreInscripciones" required style="text-transform: uppercase;" />
                </div>
                <div class="invalid-feedback">Por favor, ingresa tu primer nombre.</div>
            </div>

            <div class="animate-field">
                <label for="SegundonombreInscripciones" class="form-label">Segundo Nombre</label>
                <div class="input-with-icon">
                    <i class="fas fa-user"></i>
                    <input class="form-control" id="SegundonombreInscripciones" name="SegundonombreInscripciones" style="text-transform: uppercase;" />
                </div>
            </div>

            <div class="animate-field">
                <label for="PrimerApellidoInscripciones" class="form-label">Primer Apellido <span class="text-danger">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-user"></i>
                    <input class="form-control" id="PrimerApellidoInscripciones" name="PrimerApellidoInscripciones" required style="text-transform: uppercase;" />
                </div>
                <div class="invalid-feedback">Por favor, ingresa tu primer apellido.</div>
            </div>

            <div class="animate-field">
                <label for="SegundoApellidoInscripciones" class="form-label">Segundo Apellido</label>
                <div class="input-with-icon">
                    <i class="fas fa-user"></i>
                    <input class="form-control" id="SegundoApellidoInscripciones" name="SegundoApellidoInscripciones" style="text-transform: uppercase;" />
                </div>
            </div>

            <div class="animate-field">
                <label for="FechaNacimientoInscripciones" class="form-label">Fecha Nacimiento <span class="text-danger">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-calendar-alt"></i>
                    <input type="date" class="form-control" id="FechaNacimientoInscripciones" name="FechaNacimientoInscripciones" required onchange="calculateAge()" />
                </div>
                <div class="invalid-feedback">Por favor, selecciona tu fecha de nacimiento.</div>
            </div>

            <div class="animate-field">
                <label for="EdadInscripciones" class="form-label">Edad <span class="text-danger">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-birthday-cake"></i>
                    <input class="form-control" id="EdadInscripciones" name="EdadInscripciones" placeholder="Edad" disabled />
                </div>
            </div>

            <div class="animate-field">
                <label for="GeneroInscripciones" class="form-label">Género y/o Sexo <span class="text-danger">*</span></label>
                <select class="form-select select2-enhanced" id="GeneroInscripciones" name="GeneroInscripciones" required>
                    <option value="">Seleccionar</option>
                    <option value="MASCULINO">MASCULINO</option>
                    <option value="FEMENINO">FEMENINO</option>
                    <option value="PREFIERO NO DECIR">PREFIERO NO DECIR</option>
                </select>
            </div>

            <div class="animate-field">
                <label for="GrupoEtarreoInscripciones" class="form-label">Grupo Etareo <span class="text-danger">*</span></label>
                <select class="form-select select2-enhanced" id="GrupoEtarreoInscripciones" name="GrupoEtarreoInscripciones" required>
                    <option value="">Seleccionar</option>
                    <option value="INFANCIA (0 - 5 AÑOS)">INFANCIA (0 - 5 AÑOS)</option>
                    <option value="NIÑEZ (6 - 11 AÑOS)">NIÑEZ (6 - 11 AÑOS)</option>
                    <option value="ADOLESCENTES (12 - 19 AÑOS)">ADOLESCENTES (12 - 19 AÑOS)</option>
                    <option value="JUVENTUD (20 - 25 AÑOS)">JUVENTUD (20 - 25 AÑOS)</option>
                    <option value="ADULTEZ (26 - 60 AÑOS)">ADULTEZ (26 - 60 AÑOS)</option>
                    <option value="ADULTO MAYOR (+ 60 AÑOS)">ADULTO MAYOR (+ 60 AÑOS)</option>
                </select>
            </div>

            <div class="animate-field">
                <label for="PaisNacimientoInscripciones" class="form-label">País de Nacimiento <span class="text-danger">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-globe"></i>
                    <input class="form-control" id="PaisNacimientoInscripciones" name="PaisNacimientoInscripciones" required style="text-transform: uppercase;" />
                </div>
                <div class="invalid-feedback">Por favor, ingresa tu país de nacimiento.</div>
            </div>

            <div class="animate-field">
                <label for="DepartamentoInscripciones" class="form-label">Departamento de Nacimiento <span class="text-danger">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-map-marker-alt"></i>
                    <input class="form-control" id="DepartamentoInscripciones" name="DepartamentoInscripciones" required style="text-transform: uppercase;" />
                </div>
                <div class="invalid-feedback">Por favor, ingresa tu departamento de nacimiento.</div>
            </div>

            <div class="animate-field">
                <label for="MunicipioInscripciones" class="form-label">Municipio de Nacimiento <span class="text-danger">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-map-marked-alt"></i>
                    <input class="form-control" id="MunicipioInscripciones" name="MunicipioInscripciones" required style="text-transform: uppercase;" />
                </div>
                <div class="invalid-feedback">Por favor, ingresa tu municipio de nacimiento.</div>
            </div>

            <!-- Sección 3: Información de residencia -->
            <h5 class="section-title"><i class="fas fa-home me-2"></i>Información de Residencia</h5>

            <div class="animate-field">
                <label for="DireccionResidencia" class="form-label">Dirección de Residencia <span class="text-danger">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-map-pin"></i>
                    <input class="form-control" id="DireccionResidencia" name="DireccionResidencia" required style="text-transform: uppercase;" />
                </div>
                <div class="invalid-feedback">Por favor, ingresa tu dirección de residencia.</div>
            </div>

            <div class="animate-field">
                <label for="BarrioResidencia" class="form-label">Barrio de Residencia <span class="text-danger">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-map-signs"></i>
                    <input class="form-control" id="BarrioResidencia" name="BarrioResidencia" required style="text-transform: uppercase;" />
                </div>
                <div class="invalid-feedback">Por favor, ingresa tu barrio de residencia.</div>
            </div>

            <div class="animate-field">
                <label for="MunicipioResidencia" class="form-label">Municipio Residencia <span class="text-danger">*</span></label>
                <select class="form-select select2-enhanced" id="MunicipioResidencia" name="MunicipioResidencia" required style="text-transform: uppercase;">
                    <option value="">Seleccionar</option>
                    <option value="VALLEDUPAR">VALLEDUPAR</option>
                    <option value="AGUACHICA">AGUACHICA</option>
                    <option value="AGUSTÍN CODAZZI">AGUSTÍN CODAZZI</option>
                    <option value="ASTREA">ASTREA</option>
                    <option value="BECERRIL">BECERRIL</option>
                    <option value="BOSCONIA">BOSCONIA</option>
                    <option value="CHIMICHAGUA">CHIMICHAGUA</option>
                    <option value="CHIRIGUANÁ">CHIRIGUANÁ</option>
                    <option value="CURUMANÍ">CURUMANÍ</option>
                    <option value="EL COPEY">EL COPEY</option>
                    <option value="EL PASO">EL PASO</option>
                    <option value="GAMARRA">GAMARRA</option>
                    <option value="GONZÁLEZ">GONZÁLEZ</option>
                    <option value="LA GLORIA">LA GLORIA</option>
                    <option value="LA JAGUA DE IBIRICO">LA JAGUA DE IBIRICO</option>
                    <option value="LA PAZ">LA PAZ</option>
                    <option value="MANAURE BALCÓN DEL CESAR">MANAURE BALCÓN DEL CESAR</option>
                    <option value="PAILITAS">PAILITAS</option>
                    <option value="PELAYA">PELAYA</option>
                    <option value="PUEBLO BELLO">PUEBLO BELLO</option>
                    <option value="RÍO DE ORO">RÍO DE ORO</option>
                    <option value="SAN ALBERTO">SAN ALBERTO</option>
                    <option value="SAN DIEGO">SAN DIEGO</option>
                    <option value="SAN MARTÍN">SAN MARTÍN</option>
                    <option value="TAMALAMEQUE">TAMALAMEQUE</option>
                </select>
            </div>

            <div class="animate-field">
                <label for="EstratoResidencia" class="form-label">Estrato Residencia <span class="text-danger">*</span></label>
                <select class="form-select select2-enhanced" id="EstratoResidencia" name="EstratoResidencia" required>
                    <option value="">Seleccionar</option>
                    <option value="1">ESTRATO 1</option>
                    <option value="2">ESTRATO 2</option>
                    <option value="3">ESTRATO 3</option>
                    <option value="4">ESTRATO 4</option>
                    <option value="5">ESTRATO 5</option>
                    <option value="6">ESTRATO 6</option>
                </select>
            </div>

            <div class="animate-field">
